# Server Configuration
NODE_ENV=development
PORT=5000

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=english_tutorial_dev
DB_USER=postgres
DB_PASSWORD=your_password_here

# Alternative: Database URL (choose one method)
# DATABASE_URL=postgresql://user:password@localhost:5432/english_tutorial_dev

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRATION=7d

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Logging
LOG_LEVEL=info
