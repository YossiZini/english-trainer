# Production build (Firebase Hosting). No secrets here: these values are
# compiled into the public bundle.
# /api is rewritten by Firebase Hosting to the Cloud Run service (firebase.json).
REACT_APP_API_URL=/api
REACT_APP_ENV=production
REACT_APP_VIDEO_BASE_URL=https://storage.googleapis.com/teacher-509909-videos
REACT_APP_TELEGRAM_BOT=Yzteacher_bot
